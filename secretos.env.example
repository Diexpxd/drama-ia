# Copia este archivo a secretos.env y rellena lo que uses. secretos.env no se sube a git.

# Guionista y evaluador (basta con una de las dos primeras)
GEMINI_API_KEY=
# Claves extra de Gemini, separadas por comas (la cuota gratuita es por proyecto de Google)
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=

# Bot de Telegram: token de @BotFather y el id del chat al que obedece
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Jueces de respaldo (opcional)
NVIDIA_API_KEY=
DASHSCOPE_API_KEY=
